            {
              "listen": "test",
              "script": {
                "exec": [
                  "if ((pm.response.code >= 200) &&\r",
                  "  (pm.response.code < 300)\r",
                  ") {\r",
                  " var json = \r",
                  "     JSON.parse(pm.response.text());\r",
                  "\r",
                  "   pm.environment.set('token',\r",
                  "        json.access_token)\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{client-secret}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{client-id}}",
